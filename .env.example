# JOBSINLINE Configuration

# Server Port (Default: 5000)
PORT=5000

# Flask Debug Mode (true for local dev, false for production)
FLASK_DEBUG=false

# Flask Secret Key for session security
SECRET_KEY=jobsinline-super-secret-key-change-in-production

# MongoDB Connection String (Optional - falls back to local SQLite if unavailable)
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/jobsinline?retryWrites=true&w=majority
# Example for local MongoDB: mongodb://localhost:27017/
MONGO_URI=

# Google Gemini API Key (Optional - falls back to smart local career AI if not set)
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
